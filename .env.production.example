# Copy to .env on the server (never commit .env). Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep the existing database names; changing them does not migrate the data.
POSTGRES_USER=zenoworksuite
POSTGRES_DB=zenoworksuite
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=["https://zenoteamsuite.com","https://www.zenoteamsuite.com"]
# Optional: enables the voice agent (Sonix transcription)
SONIX_API_KEY=
# Optional: email new users their sign-in details (SendGrid). Without it, admins copy them from the screen.
APP_URL=https://zenoteamsuite.com
SENDGRID_API_KEY=
MAIL_FROM=
# Optional: GitHub integration and the AI requirements/test generator
GITHUB_TOKEN=
OPENAI_API_KEY=
# Host port the host nginx proxies to (127.0.0.1 only). 8091/8100 are taken on the shared VPS.
WEB_PORT=8092
